<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Registro de Chasis - Móvil</title>
    <style>
        :root {
            --bg: #f0f2f5;
            --card-bg: #ffffff;
            --primary: #1a73e8;
            --primary-hover: #1557b0;
            --success: #0d904f;
            --success-glow: #4caf50;
            --danger: #d93025;
            --text: #202124;
            --text-secondary: #5f6368;
            --border: #dadce0;
            --shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
            --shadow-lg: 0 4px 20px rgba(0, 0, 0, 0.12);
            --radius: 12px;
            --radius-sm: 8px;
            --transition: 0.2s ease;
            --font: 'Segoe UI', system-ui, -apple-system, sans-serif;
            --fab-size: 56px;
            --bottom-nav-height: 70px;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: var(--font);
            background: var(--bg);
            color: var(--text);
            min-height: 100vh;
            padding: 0 0 calc(var(--bottom-nav-height) + 20px) 0;
            line-height: 1.4;
            -webkit-font-smoothing: antialiased;
            -webkit-tap-highlight-color: transparent;
            user-select: none;
        }

        /* ========== HEADER ========== */
        .header {
            background: rgba(255, 255, 255, 0.95);
            padding: 12px 16px;
            box-shadow: 0 1px 4px rgba(0, 0, 0, 0.05);
            display: flex;
            align-items: center;
            gap: 10px;
            position: sticky;
            top: 0;
            z-index: 10;
            backdrop-filter: blur(10px);
        }
        .header .logo {
            font-size: 24px;
            background: var(--primary);
            color: #fff;
            width: 40px;
            height: 40px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }
        .header .title { flex: 1; }
        .header .title h1 {
            font-size: 1.1rem;
            font-weight: 700;
            letter-spacing: -0.3px;
            line-height: 1.2;
        }
        .header .title .operator-badge {
            font-size: 0.75rem;
            color: var(--text-secondary);
            display: inline-flex;
            align-items: center;
            gap: 4px;
            background: #f1f3f4;
            padding: 4px 10px;
            border-radius: 20px;
            cursor: pointer;
            transition: var(--transition);
            white-space: nowrap;
            max-width: 160px;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .header .title .operator-badge:active { background: #e8eaed; }
        .header .badge-offline {
            background: #e8eaed;
            color: var(--text-secondary);
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 0.7rem;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 4px;
            white-space: nowrap;
        }
        .header .badge-offline .dot {
            width: 6px; height: 6px; border-radius: 50%; background: #34a853;
        }

        /* ========== CONTENEDOR PRINCIPAL ========== */
        .main-content {
            padding: 12px 12px 0 12px;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        /* ========== PANEL DIARIO ========== */
        .daily-panel {
            background: var(--card-bg);
            border-radius: var(--radius);
            padding: 14px 12px;
            box-shadow: var(--shadow);
            flex: 1;
            display: flex;
            flex-direction: column;
        }
        .filter-row {
            display: flex;
            gap: 8px;
            align-items: center;
            margin-bottom: 10px;
            flex-wrap: wrap;
        }
        .filter-row input[type="date"] {
            flex: 1;
            min-width: 120px;
            padding: 10px 12px;
            border: 2px solid var(--border);
            border-radius: var(--radius-sm);
            font-size: 0.9rem;
            font-family: var(--font);
            background: #fafbfc;
            height: 44px;
        }
        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 4px;
            padding: 10px 14px;
            border-radius: var(--radius-sm);
            font-weight: 600;
            font-size: 0.8rem;
            cursor: pointer;
            border: none;
            transition: var(--transition);
            letter-spacing: 0.2px;
            font-family: var(--font);
            white-space: nowrap;
            height: 44px;
            min-width: 44px;
            background: #f1f3f4;
            color: var(--text);
        }
        .btn-primary { background: var(--primary); color: #fff; }
        .btn-success { background: var(--success); color: #fff; }
        .btn-outline { background: #fff; color: var(--primary); border: 2px solid var(--primary); }
        .btn-danger  { background: #fff; color: var(--danger); border: 2px solid var(--danger); }
        .btn:active  { transform: scale(0.96); filter: brightness(0.95); }

        .stats-mini {
            display: flex;
            gap: 8px;
            margin-bottom: 10px;
            flex-wrap: wrap;
        }
        .stat-pill {
            background: #f1f3f4;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 4px;
        }
        .stat-pill .num {
            background: var(--primary);
            color: #fff;
            border-radius: 12px;
            padding: 2px 8px;
            font-size: 0.75rem;
        }
        .next-chassis-pill {
            background: #e8f0fe;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 4px;
            color: var(--primary);
            border: 1px solid #c6dafc;
        }
        .next-chassis-pill strong { font-size: 0.95rem; }

        /* Lista de registros */
        .registrations-list {
            flex: 1;
            overflow-y: auto;
            max-height: 50vh;
            border-radius: var(--radius-sm);
        }
        .reg-item {
            background: #fafbfc;
            border-radius: var(--radius-sm);
            padding: 10px 12px;
            margin-bottom: 6px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-left: 4px solid var(--success-glow);
            transition: var(--transition);
        }
        .reg-item:active { background: #f0f2f5; }
        .reg-item .info { flex: 1; min-width: 0; }
        .reg-item .chassis-number {
            font-weight: 700;
            font-size: 1rem;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            color: var(--primary);
            letter-spacing: 0.5px;
        }
        .reg-item .meta {
            font-size: 0.72rem;
            color: var(--text-secondary);
            display: flex;
            gap: 6px;
            flex-wrap: wrap;
            margin-top: 3px;
            align-items: center;
        }
        .reg-item .flash-badge {
            background: #e6f4ea;
            color: #0d904f;
            padding: 3px 8px;
            border-radius: 10px;
            font-weight: 600;
            font-size: 0.68rem;
            border: 1px solid #c6e6cf;
            white-space: nowrap;
        }
        .obs {
            font-size: 0.72rem;
            color: #5f4b00;
            margin-top: 4px;
            background: #fff8e1;
            padding: 3px 8px;
            border-radius: 6px;
            border-left: 2px solid #fbbc04;
            white-space: pre-wrap;
            word-break: break-word;
        }
        .reg-item .delete-btn {
            background: none;
            border: none;
            font-size: 1.2rem;
            cursor: pointer;
            padding: 6px;
            color: #999;
            transition: var(--transition);
        }
        .reg-item .delete-btn:active { color: var(--danger); }
        .empty-state {
            text-align: center;
            padding: 30px;
            color: #999;
        }

        .export-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            margin-top: 10px;
        }
        .export-actions .btn {
            flex: 1;
            justify-content: center;
            font-size: 0.75rem;
            padding: 8px 6px;
            height: 40px;
        }

        /* ========== FAB ========== */
        .fab {
            position: fixed;
            bottom: calc(var(--bottom-nav-height) + 10px);
            right: 20px;
            width: var(--fab-size);
            height: var(--fab-size);
            border-radius: 50%;
            background: var(--primary);
            color: #fff;
            font-size: 28px;
            border: none;
            box-shadow: 0 6px 20px rgba(26, 115, 232, 0.5);
            cursor: pointer;
            z-index: 20;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: transform 0.2s, box-shadow 0.2s;
        }
        .fab:active {
            transform: scale(0.9);
            box-shadow: 0 3px 12px rgba(26, 115, 232, 0.4);
        }

        /* ========== MODAL ========== */
        .modal-overlay {
            position: fixed;
            top: 0; left: 0;
            width: 100%; height: 100%;
            background: rgba(0, 0, 0, 0.5);
            z-index: 30;
            display: flex;
            align-items: flex-end;
            justify-content: center;
            animation: fadeIn 0.2s ease;
        }
        @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
        .modal-sheet {
            background: #fff;
            width: 100%;
            max-width: 500px;
            border-radius: 20px 20px 0 0;
            padding: 20px 16px 30px 16px;
            box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.2);
            animation: slideUp 0.25s ease;
            max-height: 92vh;
            overflow-y: auto;
            position: relative;
        }
        @keyframes slideUp { from { transform: translateY(100%); } to { transform: translateY(0); } }
        .modal-sheet h2 {
            font-size: 1.2rem;
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .modal-sheet .close-modal {
            position: absolute;
            right: 16px;
            top: 16px;
            background: #f1f3f4;
            border: none;
            width: 32px;
            height: 32px;
            border-radius: 50%;
            font-size: 1.2rem;
            cursor: pointer;
            color: var(--text-secondary);
        }
        .modal-input {
            width: 100%;
            padding: 14px;
            border: 2px solid var(--border);
            border-radius: var(--radius-sm);
            font-size: 1rem;
            margin-bottom: 12px;
            height: 52px;
            font-family: var(--font);
            background: #fafbfc;
        }
        .modal-input:focus { outline: none; border-color: var(--primary); background: #fff; }
        .chassis-input {
            font-size: 1.5rem;
            font-weight: 700;
            letter-spacing: 3px;
            text-align: center;
            color: var(--primary);
            font-variant-numeric: tabular-nums;
        }
        textarea.modal-input {
            min-height: 70px;
            height: auto;
            resize: vertical;
            padding: 12px 14px;
            font-size: 0.95rem;
            line-height: 1.4;
        }
        .field-label {
            display: block;
            font-size: 0.78rem;
            font-weight: 700;
            color: var(--text-secondary);
            margin-bottom: 6px;
            text-transform: uppercase;
            letter-spacing: 0.4px;
        }
        .operator-selector { margin-bottom: 14px; }
        .operator-selector select {
            width: 100%;
            padding: 12px;
            border-radius: var(--radius-sm);
            border: 2px solid var(--border);
            font-size: 0.95rem;
            background: #fafbfc;
            height: 50px;
            font-family: var(--font);
        }

        /* Panel asistente */
        .assistant-panel {
            background: linear-gradient(135deg, #e8f0fe, #f3f8ff);
            border: 1px solid #c6dafc;
            border-radius: var(--radius-sm);
            padding: 10px 12px;
            margin-bottom: 12px;
        }
        .assistant-title {
            font-size: 0.7rem;
            font-weight: 800;
            color: var(--primary);
            letter-spacing: 0.6px;
            margin-bottom: 6px;
        }
        .assistant-values {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 0.85rem;
            flex-wrap: wrap;
        }
        .assistant-values span { color: var(--text-secondary); }
        .assistant-values strong {
            color: var(--primary);
            font-size: 1.05rem;
            font-variant-numeric: tabular-nums;
        }
        .assistant-values .arrow {
            color: var(--text-secondary);
            font-weight: 700;
        }

        .input-with-refresh {
            display: flex;
            gap: 8px;
            align-items: stretch;
            margin-bottom: 14px;
        }
        .input-with-refresh .modal-input { margin-bottom: 0; flex: 1; }
        .refresh-btn-inline {
            background: #f1f3f4;
            border: 2px solid var(--border);
            border-radius: var(--radius-sm);
            width: 52px;
            font-size: 1.4rem;
            cursor: pointer;
            color: var(--primary);
            display: flex;
            align-items: center;
            justify-content: center;
            transition: var(--transition);
        }
        .refresh-btn-inline:active { background: #e8eaed; transform: scale(0.95); }

        .target-date-badge {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            background: #f1f3f4;
            padding: 8px 12px;
            border-radius: 8px;
            font-size: 0.82rem;
            color: var(--text-secondary);
            margin-bottom: 14px;
            border: 1px dashed var(--border);
            flex-wrap: wrap;
        }
        .target-date-badge strong { color: var(--text); }
        .target-date-badge .clock-value {
            color: var(--primary);
            font-variant-numeric: tabular-nums;
            letter-spacing: 0.5px;
        }

        .flash-result { text-align: center; margin-top: 10px; min-height: 40px; }
        .flash-ok-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: #e6f4ea;
            color: var(--success);
            padding: 10px 20px;
            border-radius: 24px;
            font-weight: 700;
            font-size: 1rem;
            border: 2px solid #c6e6cf;
            animation: flashPulse 1.2s ease-in-out infinite;
        }
        @keyframes flashPulse {
            0%, 100% { box-shadow: 0 0 6px rgba(76, 175, 80, 0.5); }
            50% { box-shadow: 0 0 22px rgba(76, 175, 80, 0.9), 0 0 40px rgba(76, 175, 80, 0.35); }
        }

        /* Operadores modal */
        .operator-list-modal {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            margin: 8px 0 12px;
        }
        .operator-chip-modal {
            padding: 8px 14px;
            border-radius: 20px;
            background: #f1f3f4;
            font-size: 0.85rem;
            display: flex;
            align-items: center;
            gap: 6px;
            cursor: pointer;
            border: 2px solid transparent;
        }
        .operator-chip-modal.active {
            border-color: var(--primary);
            background: #e8f0fe;
            color: var(--primary);
            font-weight: 700;
        }
        .operator-chip-modal .del { font-size: 0.7rem; opacity: 0.5; }

        .toast-container {
            position: fixed;
            top: 10px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 9999;
            display: flex;
            flex-direction: column;
            gap: 6px;
            width: 90%;
            max-width: 400px;
            pointer-events: none;
        }
        .toast {
            background: #1e1e1e;
            color: #fff;
            padding: 10px 16px;
            border-radius: 8px;
            font-weight: 600;
            font-size: 0.85rem;
            text-align: center;
            animation: toastIn 0.3s ease, toastOut 0.3s ease 2s forwards;
        }
        .toast.success { border-left: 4px solid #4caf50; }
        .toast.error   { border-left: 4px solid #f44336; }
        @keyframes toastIn {
            from { opacity: 0; transform: translateY(-20px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        @keyframes toastOut {
            from { opacity: 1; }
            to   { opacity: 0; transform: translateY(-10px); }
        }

        @media (min-width: 768px) {
            body { padding: 16px; }
            .main-content { max-width: 700px; margin: 0 auto; }
            .fab { bottom: 30px; right: 30px; }
            .modal-sheet {
                border-radius: 20px;
                margin: auto;
                position: relative;
                top: 50%;
                transform: translateY(-50%);
                animation: none;
                max-height: 85vh;
            }
            .modal-overlay { align-items: center; }
        }
    </style>
</head>
<body>

    <!-- HEADER -->
    <div class="header">
        <div class="logo">🔧</div>
        <div class="title">
            <h1>Chasis</h1>
            <div class="operator-badge" id="operatorBadge" onclick="openOperatorsModal()">
                👤 <span id="currentOperatorDisplay">Sin operario</span>
            </div>
        </div>
        <div class="badge-offline"><span class="dot"></span> OFFLINE</div>
    </div>

    <!-- CONTENIDO PRINCIPAL -->
    <div class="main-content">
        <div class="daily-panel">
            <div class="filter-row">
                <input type="date" id="filterDate" onchange="renderDailyPanel()">
                <button class="btn" onclick="goToToday()" style="padding:10px;">📍 Hoy</button>
                <button class="btn" onclick="changeDay(-1)">◀</button>
                <button class="btn" onclick="changeDay(1)">▶</button>
            </div>
            <div class="stats-mini">
                <span class="stat-pill">📅 Día: <span class="num" id="statDayCount">0</span></span>
                <span class="stat-pill">📦 Total: <span class="num" id="statTotalCount">0</span></span>
                <span class="next-chassis-pill">🔢 Próximo: <strong id="statNextChassis">1</strong></span>
            </div>
            <div class="registrations-list" id="registrationsList">
                <div class="empty-state">📭 Sin registros para este día</div>
            </div>
            <div class="export-actions">
                <button class="btn btn-success" onclick="downloadPDF('day')">📄 PDF día</button>
                <button class="btn btn-success" onclick="downloadPDF('all')">📄 PDF acum.</button>
                <button class="btn btn-outline" onclick="downloadExcel('day')">📊 Excel día</button>
                <button class="btn btn-outline" onclick="downloadExcel('all')">📊 Excel acum.</button>
                <button class="btn btn-danger" onclick="clearHistory()">🗑</button>
            </div>
        </div>
    </div>

    <!-- FAB -->
    <button class="fab" id="fabRegister" onclick="openRegisterModal()">+</button>

    <!-- MODAL DE REGISTRO -->
    <div class="modal-overlay" id="registerModal" style="display:none;" onclick="closeRegisterModal(event)">
        <div class="modal-sheet" onclick="event.stopPropagation()">
            <h2>🚗 Nuevo Registro</h2>
            <button class="close-modal" onclick="closeRegisterModal()">✕</button>

            <!-- Asistente de secuencia -->
            <div class="assistant-panel">
                <div class="assistant-title">🔢 ASISTENTE DE SECUENCIA</div>
                <div class="assistant-values">
                    <span>Último: <strong id="assistantLast">—</strong></span>
                    <span class="arrow">→</span>
                    <span>Siguiente: <strong id="assistantNext">1</strong></span>
                </div>
            </div>

            <div class="target-date-badge">
                📅 Se registrará: <strong id="targetDateDisplay">—</strong>
                <span>·</span>
                🕐 <strong class="clock-value" id="targetTimeDisplay">--:--:--</strong>
            </div>

            <label class="field-label">N° de chasis (solo números)</label>
            <div class="input-with-refresh">
                <input type="text" class="modal-input chassis-input" id="modalChassisInput"
                       placeholder="0000" inputmode="numeric" pattern="[0-9]*"
                       autocomplete="off" maxlength="20">
                <button class="refresh-btn-inline" onclick="resetToNextSequence()" title="Usar siguiente sugerido">⟳</button>
            </div>

            <label class="field-label">👤 Operario</label>
            <div class="operator-selector">
                <select id="modalOperatorSelect">
                    <option value="">-- Seleccionar --</option>
                </select>
            </div>

            <label class="field-label">📝 Observaciones</label>
            <textarea class="modal-input" id="modalObservations"
                      placeholder="Observaciones (opcional)" maxlength="250"></textarea>

            <button class="btn btn-primary" style="width:100%;height:52px;font-size:1rem;" onclick="registerFromModal()">✅ Registrar Chasis</button>
            <div class="flash-result" id="modalFlashResult"></div>
        </div>
    </div>

    <!-- MODAL DE OPERARIOS -->
    <div class="modal-overlay" id="operatorsModal" style="display:none;" onclick="closeOperatorsModal(event)">
        <div class="modal-sheet" onclick="event.stopPropagation()">
            <h2>👥 Gestión de Operarios</h2>
            <button class="close-modal" onclick="closeOperatorsModal()">✕</button>
            <div style="display:flex; gap:8px; margin-bottom:10px;">
                <input type="text" id="newOperatorInput" placeholder="Nombre del operario"
                       style="flex:1; height:44px; padding:10px; border:2px solid var(--border); border-radius:8px; font-family:var(--font);">
                <button class="btn btn-primary" onclick="addOperator()">Agregar</button>
            </div>
            <div class="operator-list-modal" id="operatorChipsModal"></div>
            <p style="font-size:0.7rem;color:var(--text-secondary);">Selecciona un operario como actual. Se asignará automáticamente al registrar.</p>
        </div>
    </div>

    <div class="toast-container" id="toastContainer"></div>

    <script>
        // ==================== DATOS ====================
        const STORAGE_KEY = 'chasis_registro_data_v2';
        let appData = { operators: [], currentOperator: '', registrations: [] };

        function loadData() {
            try {
                const raw = localStorage.getItem(STORAGE_KEY);
                if (raw) appData = { ...appData, ...JSON.parse(raw) };
            } catch (e) {}
        }
        function saveData() {
            try { localStorage.setItem(STORAGE_KEY, JSON.stringify(appData)); }
            catch (e) { showToast('⚠️ Almacenamiento lleno', 'error'); }
        }
        loadData();

        // ==================== UTILIDADES ====================
        function showToast(msg, type = 'success') {
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            toast.className = `toast ${type}`;
            toast.textContent = msg;
            container.appendChild(toast);
            setTimeout(() => toast.remove(), 2300);
        }

        function escapeHTML(str) {
            const div = document.createElement('div');
            div.textContent = str == null ? '' : str;
            return div.innerHTML;
        }

        function formatDateForInput(date) {
            const y = date.getFullYear();
            const m = String(date.getMonth() + 1).padStart(2, '0');
            const d = String(date.getDate()).padStart(2, '0');
            return `${y}-${m}-${d}`;
        }

        function formatTimeNow(date) {
            return date.toLocaleTimeString('es-ES', {
                hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false
            });
        }

        function getRegistrationsByDate(dateStr) {
            return appData.registrations.filter(r => r.date === dateStr);
        }

        function getAllRegistrationsSorted() {
            return [...appData.registrations].sort((a, b) => b.timestamp - a.timestamp);
        }

        // ==================== LÓGICA DE SECUENCIA (ASISTENTE) ====================
        function incrementNumericString(str) {
            if (!/^\d+$/.test(str)) return '1';
            const arr = str.split('');
            let i = arr.length - 1;
            while (i >= 0) {
                if (arr[i] === '9') { arr[i] = '0'; i--; }
                else { arr[i] = String(parseInt(arr[i], 10) + 1); return arr.join(''); }
            }
            return '1' + arr.join('');
        }

        function getLastNumericChassis() {
            const sorted = [...appData.registrations].sort((a, b) => b.timestamp - a.timestamp);
            for (const r of sorted) {
                if (r.chassis && /^\d+$/.test(r.chassis)) return r.chassis;
            }
            return null;
        }

        function getNextChassisSuggestion() {
            const last = getLastNumericChassis();
            return last === null ? '1' : incrementNumericString(last);
        }

        function updateNextChassisDisplays() {
            const last = getLastNumericChassis();
            const next = getNextChassisSuggestion();
            const statEl = document.getElementById('statNextChassis');
            if (statEl) statEl.textContent = next;
            const lastEl = document.getElementById('assistantLast');
            const nextEl = document.getElementById('assistantNext');
            if (lastEl) lastEl.textContent = last || '—';
            if (nextEl) nextEl.textContent = next;
        }

        // ==================== FECHA Y HORA OBJETIVO ====================
        function getTargetDateString() {
            const filterDate = document.getElementById('filterDate').value;
            if (!filterDate) {
                return new Date().toLocaleDateString('es-ES',
                    { day: '2-digit', month: '2-digit', year: 'numeric' });
            }
            const p = filterDate.split('-');
            return `${p[2]}/${p[1]}/${p[0]}`;
        }

        // Reloj en vivo que muestra la hora que se va a capturar
        let targetClockInterval = null;
        function updateTargetTimeDisplay() {
            const el = document.getElementById('targetTimeDisplay');
            if (!el) return;
            el.textContent = formatTimeNow(new Date());
        }
        function startTargetClock() {
            updateTargetTimeDisplay();
            if (targetClockInterval) clearInterval(targetClockInterval);
            targetClockInterval = setInterval(updateTargetTimeDisplay, 1000);
        }
        function stopTargetClock() {
            if (targetClockInterval) {
                clearInterval(targetClockInterval);
                targetClockInterval = null;
            }
        }

        // ==================== INTERFAZ ====================
        function updateOperatorDisplay() {
            const display = document.getElementById('currentOperatorDisplay');
            const badge = document.getElementById('operatorBadge');
            if (appData.currentOperator) {
                display.textContent = appData.currentOperator;
                badge.style.color = 'var(--primary)';
            } else {
                display.textContent = 'Sin operario';
                badge.style.color = 'var(--text-secondary)';
            }
            const sel = document.getElementById('modalOperatorSelect');
            sel.innerHTML = '<option value="">-- Seleccionar --</option>';
            appData.operators.forEach(op => {
                const opt = document.createElement('option');
                opt.value = op;
                opt.textContent = op;
                if (op === appData.currentOperator) opt.selected = true;
                sel.appendChild(opt);
            });
            sel.value = appData.currentOperator;
        }

        function renderDailyPanel() {
            const filterDate = document.getElementById('filterDate');
            if (!filterDate.value) filterDate.value = formatDateForInput(new Date());

            const p = filterDate.value.split('-');
            const displayDate = `${p[2]}/${p[1]}/${p[0]}`;
            const dayRegs = getRegistrationsByDate(displayDate);

            document.getElementById('statDayCount').textContent = dayRegs.length;
            document.getElementById('statTotalCount').textContent = appData.registrations.length;

            const list = document.getElementById('registrationsList');
            if (dayRegs.length === 0) {
                list.innerHTML = '<div class="empty-state">📭 Sin registros para este día</div>';
            } else {
                const sorted = [...dayRegs].sort((a, b) => b.timestamp - a.timestamp);
                list.innerHTML = sorted.map(r => `
                    <div class="reg-item">
                        <div class="info">
                            <div class="chassis-number">🔹 ${escapeHTML(r.chassis)}</div>
                            <div class="meta">
                                <span>📅 ${r.date}</span>
                                <span>🕐 ${r.time ? escapeHTML(r.time) : '—'}</span>
                                <span>👤 ${escapeHTML(r.operator)}</span>
                                <span class="flash-badge">⚡ FLASH OK</span>
                            </div>
                            ${r.observations ? `<div class="obs">📝 ${escapeHTML(r.observations)}</div>` : ''}
                        </div>
                        <button class="delete-btn" onclick="deleteRegistration(${r.timestamp})">🗑</button>
                    </div>
                `).join('');
            }
            updateNextChassisDisplays();
        }

        function deleteRegistration(timestamp) {
            if (!confirm('¿Eliminar este registro?')) return;
            appData.registrations = appData.registrations.filter(r => r.timestamp !== timestamp);
            saveData();
            renderDailyPanel();
            showToast('🗑 Registro eliminado', 'error');
        }

        function goToToday() {
            document.getElementById('filterDate').value = formatDateForInput(new Date());
            renderDailyPanel();
        }

        function changeDay(offset) {
            const input = document.getElementById('filterDate');
            if (!input.value) { goToToday(); return; }
            const p = input.value.split('-');
            const d = new Date(parseInt(p[0]), parseInt(p[1]) - 1, parseInt(p[2]));
            d.setDate(d.getDate() + offset);
            input.value = formatDateForInput(d);
            renderDailyPanel();
        }

        // ==================== MODALES ====================
        function openRegisterModal() {
            document.getElementById('registerModal').style.display = 'flex';
            document.getElementById('modalFlashResult').innerHTML = '';
            document.getElementById('modalObservations').value = '';
            document.getElementById('targetDateDisplay').textContent = getTargetDateString();

            updateOperatorDisplay();
            updateNextChassisDisplays();
            startTargetClock();

            const input = document.getElementById('modalChassisInput');
            input.value = getNextChassisSuggestion();

            setTimeout(() => {
                input.focus();
                try { input.setSelectionRange(0, input.value.length); } catch (e) {}
            }, 120);
        }

        function closeRegisterModal(e) {
            if (e && e.target !== document.getElementById('registerModal')) return;
            document.getElementById('registerModal').style.display = 'none';
            document.getElementById('modalFlashResult').innerHTML = '';
            stopTargetClock();
        }

        function resetToNextSequence() {
            const input = document.getElementById('modalChassisInput');
            input.value = getNextChassisSuggestion();
            input.focus();
            try { input.setSelectionRange(0, input.value.length); } catch (e) {}
        }

        function registerFromModal() {
            const chassis = document.getElementById('modalChassisInput').value.trim();
            const operator = document.getElementById('modalOperatorSelect').value;
            const observations = document.getElementById('modalObservations').value.trim();

            if (!chassis) { showToast('⚠️ Ingrese el número de chasis', 'error'); return; }
            if (!/^\d+$/.test(chassis)) { showToast('⚠️ Solo se permiten números', 'error'); return; }
            if (!operator && !appData.currentOperator) { showToast('⚠️ Seleccione un operario', 'error'); return; }

            if (appData.registrations.some(r => r.chassis === chassis)) {
                if (!confirm(`El chasis ${chassis} ya está registrado. ¿Registrar de todos modos?`)) return;
            }

            const finalOperator = operator || appData.currentOperator;
            const now = new Date();
            const timeStr = formatTimeNow(now);   // ← Hora capturada automáticamente

            appData.registrations.push({
                chassis: chassis,
                date: getTargetDateString(),      // fecha (día) automática
                time: timeStr,                    // ← hora automática
                operator: finalOperator,
                flashOK: true,
                observations: observations,
                timestamp: now.getTime()          // interno
            });

            if (operator && operator !== appData.currentOperator) {
                appData.currentOperator = operator;
                updateOperatorDisplay();
            }

            saveData();

            // Efecto FLASH OK
            document.getElementById('modalFlashResult').innerHTML =
                '<div class="flash-ok-badge">⚡ FLASH OK</div>';

            // Preparar el siguiente registro automáticamente
            document.getElementById('modalObservations').value = '';
            const input = document.getElementById('modalChassisInput');
            input.value = getNextChassisSuggestion();
            updateNextChassisDisplays();

            setTimeout(() => {
                document.getElementById('modalFlashResult').innerHTML = '';
                input.focus();
                try { input.setSelectionRange(0, input.value.length); } catch (e) {}
            }, 900);

            renderDailyPanel();
            showToast(`✅ Chasis ${chassis} registrado (${timeStr})`, 'success');
        }

        function openOperatorsModal() {
            document.getElementById('operatorsModal').style.display = 'flex';
            renderOperatorsChips();
        }
        function closeOperatorsModal(e) {
            if (e && e.target !== document.getElementById('operatorsModal')) return;
            document.getElementById('operatorsModal').style.display = 'none';
        }

        function renderOperatorsChips() {
            const container = document.getElementById('operatorChipsModal');
            if (appData.operators.length === 0) {
                container.innerHTML = '<span style="color:#999;">No hay operarios</span>';
                return;
            }
            container.innerHTML = appData.operators.map(op => `
                <div class="operator-chip-modal ${op === appData.currentOperator ? 'active' : ''}"
                     onclick="selectOperator('${escapeHTML(op).replace(/'/g, "\\'")}')">
                    ${escapeHTML(op)}
                    <span class="del" onclick="event.stopPropagation();deleteOperator('${escapeHTML(op).replace(/'/g, "\\'")}')">✕</span>
                </div>
            `).join('');
        }

        function addOperator() {
            const input = document.getElementById('newOperatorInput');
            const name = input.value.trim();
            if (!name) { showToast('⚠️ Ingrese un nombre', 'error'); return; }
            if (appData.operators.includes(name)) { showToast('⚠️ Ya existe', 'error'); return; }
            appData.operators.push(name);
            if (!appData.currentOperator || appData.operators.length === 1) {
                appData.currentOperator = name;
            }
            saveData();
            updateOperatorDisplay();
            renderOperatorsChips();
            input.value = '';
            showToast(`✅ Operario "${name}" agregado`, 'success');
        }

        function selectOperator(opName) {
            appData.currentOperator = opName;
            saveData();
            updateOperatorDisplay();
            renderOperatorsChips();
            showToast(`👤 Operario actual: ${opName}`, 'success');
        }

        function deleteOperator(opName) {
            if (!confirm(`¿Eliminar "${opName}"?`)) return;
            appData.operators = appData.operators.filter(o => o !== opName);
            if (appData.currentOperator === opName) {
                appData.currentOperator = appData.operators.length > 0 ? appData.operators[0] : '';
            }
            saveData();
            updateOperatorDisplay();
            renderOperatorsChips();
            showToast(`🗑 "${opName}" eliminado`, 'error');
        }

        // ==================== EXPORTACIONES ====================
        function downloadExcel(mode) {
            let regs = [], suffix = '';
            const filterDate = document.getElementById('filterDate').value;
            if (mode === 'day') {
                if (!filterDate) { showToast('⚠️ Seleccione fecha', 'error'); return; }
                const p = filterDate.split('-');
                const disp = `${p[2]}/${p[1]}/${p[0]}`;
                regs = getRegistrationsByDate(disp);
                suffix = `dia_${p[2]}-${p[1]}-${p[0]}`;
            } else {
                regs = getAllRegistrationsSorted();
                suffix = 'acumulado';
            }
            if (regs.length === 0) { showToast('⚠️ Sin datos', 'error'); return; }

            const BOM = '\uFEFF';
            const headers = ['N°', 'Chasis', 'Fecha', 'Hora', 'Operario', 'Estado', 'Observaciones'];
            const rows = regs.map((r, i) => [
                i + 1, r.chassis, r.date, r.time || '', r.operator, 'FLASH OK', r.observations || ''
            ]);
            const escapeCSV = f => {
                const s = String(f);
                if (s.includes(',') || s.includes('"') || s.includes('\n'))
                    return '"' + s.replace(/"/g, '""') + '"';
                return s;
            };
            const csv = BOM + [headers, ...rows].map(row => row.map(escapeCSV).join(',')).join('\n');
            const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `registro_chasis_${suffix}.csv`;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
            showToast(`📊 Excel descargado (${regs.length})`, 'success');
        }

        function downloadPDF(mode) {
            let regs = [], title = '';
            const filterDate = document.getElementById('filterDate').value;
            if (mode === 'day') {
                if (!filterDate) { showToast('⚠️ Seleccione fecha', 'error'); return; }
                const p = filterDate.split('-');
                const disp = `${p[2]}/${p[1]}/${p[0]}`;
                regs = getRegistrationsByDate(disp);
                title = `Día: ${disp}`;
            } else {
                regs = getAllRegistrationsSorted();
                title = 'Acumulado';
            }
            if (regs.length === 0) { showToast('⚠️ Sin datos', 'error'); return; }

            const now = new Date();
            const printDate = now.toLocaleDateString('es-ES',
                { day: '2-digit', month: '2-digit', year: 'numeric' });
            const printTime = now.toLocaleTimeString('es-ES',
                { hour: '2-digit', minute: '2-digit', hour12: false });
            const html = `
            <!DOCTYPE html><html><head><meta charset="UTF-8"><title>Informe</title>
            <style>
                body{font-family:Arial;margin:20px;color:#222;}
                h1{color:#1a73e8;}
                table{width:100%;border-collapse:collapse;font-size:12px;}
                th{background:#f1f3f4;padding:8px;text-align:left;}
                td{padding:6px;border-bottom:1px solid #ddd;}
                .flash{color:#0d904f;font-weight:bold;}
                @page{margin:1cm;}
            </style></head>
            <body><h1>📋 Registro de Chasis - ${title}</h1>
            <p>Generado: ${printDate} ${printTime} | Total: ${regs.length}</p>
            <table>
                <tr><th>#</th><th>Chasis</th><th>Fecha</th><th>Hora</th><th>Operario</th><th>Estado</th><th>Observaciones</th></tr>
                ${regs.map((r, i) => `<tr>
                    <td>${i + 1}</td>
                    <td>${escapeHTML(r.chassis)}</td>
                    <td>${r.date}</td>
                    <td>${escapeHTML(r.time || '')}</td>
                    <td>${escapeHTML(r.operator)}</td>
                    <td class="flash">⚡ FLASH OK</td>
                    <td>${escapeHTML(r.observations || '')}</td>
                </tr>`).join('')}
            </table></body><script>window.onload=function(){window.print();};<\/script></html>`;

            const w = window.open('', '_blank', 'width=800,height=600');
            if (w) { w.document.write(html); w.document.close(); }
            else { showToast('⚠️ Permita ventanas emergentes', 'error'); }
            showToast('📄 Abriendo PDF...', 'success');
        }

        function clearHistory() {
            if (!confirm('⚠️ ¿Borrar TODO el historial?')) return;
            if (!confirm('Confirmación final')) return;
            appData.registrations = [];
            saveData();
            renderDailyPanel();
            showToast('🗑 Historial limpiado', 'error');
        }

        // ==================== INICIALIZACIÓN ====================
        function init() {
            document.getElementById('filterDate').value = formatDateForInput(new Date());
            updateOperatorDisplay();
            renderDailyPanel();

            const chassisInput = document.getElementById('modalChassisInput');
            chassisInput.addEventListener('input', function () {
                const cleaned = this.value.replace(/\D/g, '');
                if (cleaned !== this.value) this.value = cleaned;
            });

            chassisInput.addEventListener('keydown', function (e) {
                if (e.key === 'Enter') { e.preventDefault(); registerFromModal(); }
            });

            document.getElementById('newOperatorInput').addEventListener('keydown', function (e) {
                if (e.key === 'Enter') { e.preventDefault(); addOperator(); }
            });

            window.addEventListener('click', function (e) {
                if (e.target === document.getElementById('registerModal')) closeRegisterModal(e);
                if (e.target === document.getElementById('operatorsModal')) closeOperatorsModal(e);
            });
        }
        init();
    </script>
</body>
</html>